# Kopieren nach .deploy.env und anpassen (.deploy.env wird nicht committet)

# SSH-Ziel (user@host)
DEPLOY_HOST=user@server.example.de
DEPLOY_PORT=22

# Projektordner (git-Clone) auf dem Server; der Document Root zeigt auf $DEPLOY_PATH/public
DEPLOY_PATH=/home/user/padd

DEPLOY_BRANCH=main

# PHP-CLI auf dem Server (z. B. php8.3, falls der Hoster mehrere Versionen hat)
REMOTE_PHP=php

# composer.phar liegt in $DEPLOY_PATH
REMOTE_COMPOSER="php composer.phar"
